<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rescue_robot">

    <!-- ===================================================== -->
    <!-- NeuroMemory Rescue Robot Model Skeleton                -->
    <!-- Differential-drive style body + camera sensor           -->
    <!-- ===================================================== -->

    <pose>0 0 0.12 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.18</iyy>
          <izz>0.25</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.75 0.55 0.22</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.75 0.55 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.15 0.28 1</ambient>
          <diffuse>0.08 0.25 0.45 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Left wheel -->
    <link name="left_wheel">
      <pose>0 0.34 0.0 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Right wheel -->
    <link name="right_wheel">
      <pose>0 -0.34 0.0 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Front caster -->
    <link name="front_caster">
      <pose>0.32 0 0.0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Camera mast -->
    <link name="camera_mast">
      <pose>0.25 0 0.42 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Camera link -->
    <link name="camera_link">
      <pose>0.42 0 0.72 0 0 0</pose>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.18 0.12 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <pose>0 0 0 0 0 0</pose>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50</far>
          </clip>
        </camera>

        <topic>/camera/image_raw</topic>
      </sensor>
    </link>

    <!-- Joints -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <joint name="camera_mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_mast</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>camera_mast</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>